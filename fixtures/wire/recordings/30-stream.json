{
  "scenario": "30-stream",
  "about": "The event stream itself: the opening frames, topic filters, resuming with ?since= or Last-Event-ID, resync when the gap cannot be replayed, and POST /stream/focus.",
  "exchanges": [
    {
      "step": {
        "name": "open",
        "open": "all",
        "capture": {
          "epoch": "/frames/all/2/data/epoch"
        }
      },
      "route": "GET /stream",
      "response": {
        "frames": {
          "all": [
            {
              "retry": 2000
            },
            {
              "comment": "connected"
            },
            {
              "data": {
                "caps": [
                  "state:patch"
                ],
                "epoch": "<epoch>",
                "seq": "<seq>"
              },
              "event": "hello",
              "id": "<stream-id>"
            }
          ]
        },
        "headers": {
          "cache-control": "no-cache, no-transform",
          "content-type": "text/event-stream",
          "x-accel-buffering": "no"
        },
        "status": 200
      }
    },
    {
      "step": {
        "name": "one-event",
        "request": "POST /workers/o-ORCH/notify",
        "body": {
          "body": "one",
          "title": "First"
        },
        "status": 200,
        "wait": [
          "notification:fire"
        ]
      },
      "route": "POST /workers/:id/notify",
      "response": {
        "frames": {
          "all": [
            {
              "data": {
                "payload": {
                  "body": "one",
                  "title": "First",
                  "ts": "<now>",
                  "workerId": "o-ORCH"
                },
                "reason": "notification:fire",
                "ts": "<now>"
              },
              "event": "change",
              "id": "<stream-id>"
            }
          ]
        },
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "ok": true
        },
        "status": 200
      }
    },
