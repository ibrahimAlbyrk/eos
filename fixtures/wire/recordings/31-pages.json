{
  "scenario": "31-pages",
  "about": "Pages (markdown notes): create, list by project, read, save with a base revision, targeted edits by an agent, delete; with the pages:change frames.",
  "exchanges": [
    {
      "step": {
        "name": "open-stream",
        "open": "main",
        "query": {
          "topics": "pages:*"
        }
      },
      "route": "GET /stream",
      "response": {
        "frames": {
          "main": [
            {
              "retry": 2000
            },
            {
              "comment": "connected"
            },
            {
              "data": {
                "caps": [
                  "state:patch"
                ],
                "epoch": "<epoch>",
                "seq": "<seq>"
              },
              "event": "hello",
              "id": "<stream-id>"
            }
          ]
        },
        "headers": {
          "cache-control": "no-cache, no-transform",
          "content-type": "text/event-stream",
          "x-accel-buffering": "no"
        },
        "status": 200
      }
    },
    {
      "step": {
        "name": "list-empty",
        "request": "GET /api/pages",
        "query": {
          "all": "1"
