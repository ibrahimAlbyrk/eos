{
  "scenario": "39-fs-writes",
  "about": "Changing files through the daemon: write, create, rename, move, paste, the folder and git watches with their change frames, recents and projects.",
  "exchanges": [
    {
      "step": {
        "name": "open-stream",
        "open": "main",
        "query": {
          "clientId": "wire-tab",
          "topics": "fs:*,git:*,projects:*,recents:*"
        }
      },
      "route": "GET /stream",
      "response": {
        "frames": {
          "main": [
            {
              "retry": 2000
            },
            {
              "comment": "connected"
            },
            {
              "data": {
                "caps": [
                  "state:patch"
                ],
                "epoch": "<epoch>",
                "seq": "<seq>"
              },
              "event": "hello",
              "id": "<stream-id>"
            }
          ]
        },
        "headers": {
          "cache-control": "no-cache, no-transform",
          "content-type": "text/event-stream",
          "x-accel-buffering": "no"
        },
        "status": 200
      }
    },
    {
      "step": {
        "name": "write-without-token",
        "request": "POST /fs/write",
        "auth": "none",
        "body": {
          "content": "x",
          "path": "{sandbox}/beta/written.md"
        },
        "status": 403
      },
      "route": "POST /fs/write",
      "response": {
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "error": "ui token required"
        },
        "status": 403
      }
    },
    {
      "step": {
        "name": "write",
        "request": "POST /fs/write",
        "body": {
          "content": "# Written\n",
          "path": "{sandbox}/beta/written.md"
        },
        "status": 200
      },
      "route": "POST /fs/write",
      "response": {
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "ok": true
        },
        "status": 200
      }
    },
    {
      "step": {
        "name": "write-in-root",
        "request": "POST /fs/write",
        "body": {
          "content": "nested\n",
          "mkdirp": true,
          "path": "deep/er/file.txt",
          "root": "{sandbox}/beta"
        },
        "status": 200
      },
      "route": "POST /fs/write",
      "response": {
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "ok": true
        },
        "status": 200
      }
    },
    {
      "step": {
        "name": "write-escapes-root",
        "request": "POST /fs/write",
        "body": {
          "content": "x",
          "path": "../alpha/x.txt",
          "root": "{sandbox}/beta"
        },
        "status": 400
      },
      "route": "POST /fs/write",
      "response": {
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "error": "path escapes root"
        },
        "status": 400
      }
    },
    {
      "step": {
        "name": "write-relative",
        "request": "POST /fs/write",
        "body": {
          "content": "x",
          "path": "written.md"
        },
        "status": 400
      },
      "route": "POST /fs/write",
      "response": {
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "error": "absolute path required"
        },
        "status": 400
      }
    },
    {
      "step": {
        "name": "write-invalid",
        "request": "POST /fs/write",
        "body": {
          "path": "{sandbox}/beta/written.md"
        },
        "status": 400
      },
      "route": "POST /fs/write",
      "response": {
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "error": "invalid request: content: Required"
        },
        "status": 400
      }
    },
    {
      "step": {
        "name": "watch",
        "request": "POST /fs/watch",
        "body": {
          "clientId": "wire-tab",
          "dir": "{sandbox}/beta",
          "root": "{sandbox}/beta"
        },
        "status": 200,
        "pause_ms": 300
      },
      "route": "POST /fs/watch",
      "response": {
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "ok": true
        },
        "status": 200
      }
    },
    {
      "step": {
        "name": "watch-without-token",
        "request": "POST /fs/watch",
        "auth": "none",
        "body": {
          "clientId": "wire-tab",
          "dir": "{sandbox}/beta",
          "root": "{sandbox}/beta"
        },
        "status": 403
      },
      "route": "POST /fs/watch",
      "response": {
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "error": "ui token required"
        },
        "status": 403
      }
    },
    {
      "step": {
        "name": "create-file",
        "request": "POST /fs/create",
        "body": {
          "content": "made\n",
          "path": "created.txt",
          "root": "{sandbox}/beta",
          "type": "file"
        },
        "status": 200,
        "wait": [
          "fs:change"
        ],
        "pause_ms": 500
      },
      "route": "POST /fs/create",
      "response": {
        "frames": {
          "main": [
            {
              "data": {
                "payload": {
                  "changes": [
                    {
                      "dir": "{sandbox}/beta",
                      "kind": "add",
                      "path": "{sandbox}/beta/created.txt",
                      "ts": "<now>"
                    }
                  ]
                },
                "reason": "fs:change",
                "ts": "<now>"
              },
              "event": "change",
              "id": "<stream-id>"
            }
          ]
        },
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "ok": true,
          "path": "{sandbox}/beta/created.txt"
        },
        "status": 200
      }
    },
    {
      "step": {
        "name": "create-folder",
        "request": "POST /fs/create",
        "body": {
          "path": "folder",
          "root": "{sandbox}/beta",
          "type": "directory"
        },
        "status": 200,
        "wait": [
          "fs:change"
        ]
      },
      "route": "POST /fs/create",
      "response": {
        "frames": {
          "main": [
            {
              "data": {
                "payload": {
                  "changes": [
                    {
                      "dir": "{sandbox}/beta",
                      "kind": "addDir",
                      "path": "{sandbox}/beta/folder",
                      "ts": "<now>"
                    }
                  ]
                },
                "reason": "fs:change",
                "ts": "<now>"
              },
              "event": "change",
              "id": "<stream-id>"
            }
          ]
        },
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "ok": true,
          "path": "{sandbox}/beta/folder"
        },
        "status": 200
      }
    },
    {
      "step": {
        "name": "create-existing",
        "request": "POST /fs/create",
        "body": {
          "path": "created.txt",
          "root": "{sandbox}/beta",
          "type": "file"
        },
        "status": 409
      },
      "route": "POST /fs/create",
      "response": {
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "error": "already exists: {sandbox}/beta/created.txt"
        },
        "status": 409
      }
    },
    {
      "step": {
        "name": "create-escape",
        "request": "POST /fs/create",
        "body": {
          "path": "../x.txt",
          "root": "{sandbox}/beta",
          "type": "file"
        },
        "status": 400
      },
      "route": "POST /fs/create",
      "response": {
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "error": "path escapes root"
        },
        "status": 400
      }
    },
    {
      "step": {
        "name": "rename",
        "request": "POST /fs/rename",
        "body": {
          "newName": "renamed.txt",
          "path": "created.txt",
          "root": "{sandbox}/beta"
        },
        "status": 200,
        "wait": [
          "fs:change"
        ]
      },
      "route": "POST /fs/rename",
      "response": {
        "frames": {
          "main": [
            {
              "data": {
                "payload": {
                  "changes": [
                    {
                      "dir": "{sandbox}/beta",
                      "kind": "unlink",
                      "path": "{sandbox}/beta/created.txt",
                      "ts": "<now>"
                    },
                    {
                      "dir": "{sandbox}/beta",
                      "kind": "add",
                      "path": "{sandbox}/beta/renamed.txt",
                      "ts": "<now>"
                    }
                  ]
                },
                "reason": "fs:change",
                "ts": "<now>"
              },
              "event": "change",
              "id": "<stream-id>"
            }
          ]
        },
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "ok": true,
          "path": "{sandbox}/beta/renamed.txt"
        },
        "status": 200
      }
    },
    {
      "step": {
        "name": "rename-bad-name",
        "request": "POST /fs/rename",
        "body": {
          "newName": "a/b",
          "path": "renamed.txt",
          "root": "{sandbox}/beta"
        },
        "status": 400
      },
      "route": "POST /fs/rename",
      "response": {
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "error": "invalid request: newName: name cannot contain '/' or null"
        },
        "status": 400
      }
    },
    {
      "step": {
        "name": "rename-missing",
        "request": "POST /fs/rename",
        "body": {
          "newName": "x.txt",
          "path": "nope.txt",
          "root": "{sandbox}/beta"
        },
        "status": 404
      },
      "route": "POST /fs/rename",
      "response": {
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "error": "path not found: {sandbox}/beta/nope.txt"
        },
        "status": 404
      }
    },
    {
      "step": {
        "name": "move",
        "request": "POST /fs/move",
        "body": {
          "destDir": "folder",
          "paths": [
            "renamed.txt"
          ],
          "root": "{sandbox}/beta"
        },
        "status": 200,
        "wait": [
          "fs:change"
        ]
      },
      "route": "POST /fs/move",
      "response": {
        "frames": {
          "main": [
            {
              "data": {
                "payload": {
                  "changes": [
                    {
                      "dir": "{sandbox}/beta",
                      "kind": "unlink",
                      "path": "{sandbox}/beta/renamed.txt",
                      "ts": "<now>"
                    }
                  ]
                },
                "reason": "fs:change",
                "ts": "<now>"
              },
              "event": "change",
              "id": "<stream-id>"
            }
          ]
        },
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "ok": true,
          "results": [
            {
              "from": "renamed.txt",
              "ok": true
            }
          ]
        },
        "status": 200
      }
    },
    {
      "step": {
        "name": "move-conflict",
        "request": "POST /fs/move",
        "body": {
          "destDir": "folder",
          "paths": [
            "folder/renamed.txt"
          ],
          "root": "{sandbox}/beta"
        },
        "status": 200
      },
      "route": "POST /fs/move",
      "response": {
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "ok": false,
          "results": [
            {
              "error": "already in destination",
              "from": "folder/renamed.txt",
              "ok": false
            }
          ]
        },
        "status": 200
      }
    },
    {
      "step": {
        "name": "list-after",
        "request": "GET /fs/list",
        "query": {
          "cwd": "{sandbox}/beta",
          "dir": "folder"
        },
        "status": 200
      },
      "route": "GET /fs/list",
      "response": {
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "entries": [
            {
              "absolutePath": "{sandbox}/beta/folder/renamed.txt",
              "isSymlink": false,
              "name": "renamed.txt",
              "relativePath": "folder/renamed.txt",
              "type": "file"
            }
          ]
        },
        "status": 200
      }
    },
    {
      "step": {
        "name": "trash-without-token",
