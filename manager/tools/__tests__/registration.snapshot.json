{
  "orchestrator": {
    "spawn_worker": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "description": "The worker's first user-turn (string). Follow the worker-prompt template in your system prompt (§Worker prompts: directive · Context · Acceptance · Out of scope · Report)."
        },
        "name": {
          "type": "string",
          "description": "Friendly slug for the worker (kebab-case). Should describe the outcome, not the action. Good: 'refactor-auth-tokens', 'add-billing-tests'. Bad: 'worker-1', 'fix-stuff', 'task'."
        },
        "model": {
          "type": "string",
          "description": "Model power tier — one of the tiers the active provider defines (listed strongest-first in your §Model table), mapped to that provider's own models. Also accepts a concrete model id or 'provider/model' sugar (e.g. 'deepseek/deepseek-v4-pro' — sugar for backendProfile=<provider> + model=<rest>, the prefix split off before the API). A tier the provider does not define is rejected. A bare cross-provider model MUST use the combined form, or it will be rejected. Omit ⇒ the provider's default tier."
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "description": "Reasoning effort. Honored only when the active provider exposes an effort lever; ignored otherwise. Which level fits which work → §Model. Omit ⇒ default."
        },
        "workspaceOf": {
          "type": "string",
          "description": "Spawn this worker INSIDE an existing worker's isolated worktree instead of a fresh one, for direct file access (to review, continue, or fix that worker's work). Pass the id of a worker you spawned (attaching to another orchestrator's worker is rejected). Only allowed while that worker is idle (fails with a conflict while it is busy)."
        },
        "collaborate": {
          "type": "boolean",
          "description": "Give this worker the peer tools (list_peers / ask_peer / respond_to_peer) so it can consult — and be consulted by — the other collaborate workers you spawn under you (its siblings). Omit ⇒ off."
        },
        "from": {
          "type": "string",
          "description": "Available worker (definition) to spawn from. It pre-fills this worker's defaults (model, effort, permission mode, persistence) and frames its instructions — fields you pass explicitly still win. Omit ⇒ defaults to the general-purpose worker."
        },
        "toolsAllow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Fence THIS worker's tools for a one-off (globs, e.g. 'Read', 'mcp__*'). Allowlist is exhaustive: anything not listed is denied. Empty/omit ⇒ inherit all tools. Wins over a `from` definition's allowlist."
        },
        "toolsDeny": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Subtract tools from THIS one-off worker (globs). Always subtracts, even from an allowlist. Wins over a `from` definition's denylist."
        },
        "editRegex": {
          "type": "string",
          "description": "Confine THIS one-off worker's file edits to paths matching this regex (e.g. '(^|/)src/.*\\\\.ts$'). Claude Code passes ABSOLUTE file paths, so anchor with `(^|/)path`, not `^path` (a `^`-anchored relative pattern never matches). Enforced at the gate. Wins over a `from` definition's editRegex."
        }
      },
      "required": [
        "prompt"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "list_active_workers": {
      "type": "object",
      "properties": {},
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "get_worker": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Worker id, e.g. 'w-abcd1234'"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "kill_worker": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Worker id, e.g. 'w-abcd1234'"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "message_worker": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Worker id, e.g. 'w-abcd1234'"
        },
        "text": {
          "type": "string",
          "description": "The follow-up directive — becomes a new user-turn for the worker. State the new ask clearly and in full."
        }
      },
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "list_pending_permissions": {
      "type": "object",
      "properties": {},
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "notify_user": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Short headline, a few words. E.g. 'Task complete'"
        },
        "body": {
          "type": "string",
          "description": "One sentence with the concrete outcome. E.g. 'Auth refactor done across 3 workers — review ready.'"
        }
      },
      "required": [
        "title",
        "body"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "ask_user": {
      "type": "object",
      "properties": {
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string",
                "description": "The complete question, ending with a question mark."
              },
              "header": {
                "type": "string",
                "description": "Short chip label, max ~12 chars. E.g. 'Approach'."
              },
              "multiSelect": {
                "type": "boolean",
                "description": "Allow picking several options."
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "description": "Concise choice text (1-5 words)."
                    },
                    "description": {
                      "type": "string",
                      "description": "What this choice means / its trade-off."
                    }
                  },
                  "required": [
                    "label"
                  ],
                  "additionalProperties": false
                },
                "minItems": 2,
                "maxItems": 4,
                "description": "2-4 distinct choices. The dashboard adds a free-text 'Other' automatically."
              }
            },
            "required": [
              "question",
              "options"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 4,
          "description": "1-4 questions, shown to the operator as one banner."
        }
      },
      "required": [
        "questions"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "list_available_workers": {
      "type": "object",
      "properties": {},
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "create_worker": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Identity, kebab-case (e.g. 'perf-profiler')."
        },
        "description": {
          "type": "string",
          "description": "Human-facing label for this worker."
        },
        "whenToUse": {
          "type": "string",
          "description": "Routing signal: when should a task be dispatched to this worker."
        },
        "model": {
          "type": "string",
          "description": "Default model power tier — one of the tiers the active provider defines (listed in your §Model table), mapped to that provider's own models. Also accepts a concrete model id or 'provider/model' sugar. Omit ⇒ inherit."
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "description": "Default reasoning effort. Honored only when the active provider exposes an effort lever; ignored otherwise. Omit ⇒ inherit."
        },
        "permissionMode": {
          "type": "string",
          "enum": [
            "acceptEdits",
            "bypassPermissions"
          ],
          "description": "Default permission mode."
        },
        "persistent": {
          "type": "boolean",
          "description": "Stay alive after a turn (conversational session)."
        },
        "collaborate": {
          "type": "boolean",
          "description": "Default the peer-mesh opt-in."
        },
        "toolsAllow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tool allowlist (globs, e.g. 'Read', 'mcp__*'). Empty/omit ⇒ inherit all tools."
        },
        "toolsDeny": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tool denylist (globs). Always subtracts, even from an allowlist."
        },
        "editRegex": {
          "type": "string",
          "description": "Restrict file edits to paths matching this regex (e.g. '(^|/)src/.*\\\\.ts$'). Claude Code passes ABSOLUTE file paths, so anchor with `(^|/)path`, not `^path` (a `^`-anchored relative pattern never matches)."
        },
        "extends": {
          "type": "string",
          "description": "Base worker name to inherit unset fields from."
        },
        "body": {
          "type": "string",
          "description": "This worker's role-instructions body (string). What to put in it / what NOT to (never restate the signal protocol / report / Handover) → create_worker's description and §Available workers."
        }
      },
      "required": [
        "name",
        "body"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "integrate_workers": {
      "type": "object",
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Limit to these worker ids. Omit to integrate ALL of your workers' branches."
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "current_datetime": {
      "type": "object",
      "properties": {},
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "get_worker_messages": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Worker id, e.g. 'w-abcd1234'"
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 5,
          "description": "How many of the worker's most recent messages to return (5 = last five, 1 = just the latest)."
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "browser_navigate": {
      "type": "object",
      "properties": {
        "tabId": {
          "type": "string",
          "description": "Tab to drive; omit for the active tab"
        },
        "action": {
          "type": "string",
          "enum": [
            "url",
            "back",
            "forward",
            "reload"
          ],
          "description": "\"url\" loads `url`; back/forward walk history; reload refreshes"
        },
        "url": {
          "type": "string",
          "description": "Target URL — required when action is \"url\""
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "browser_snapshot": {
      "type": "object",
      "properties": {
        "tabId": {
          "type": "string",
          "description": "Tab to read; omit for the active tab"
        },
        "interactiveOnly": {
          "type": "boolean",
          "default": true,
          "description": "Only interactive elements (buttons, links, inputs) — keeps the tree small"
        },
        "selector": {
          "type": "string",
          "description": "Scope the tree to a CSS-selector subtree"
        },
        "depth": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Limit tree depth"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "browser_find": {
      "type": "object",
      "properties": {
        "tabId": {
          "type": "string",
          "description": "Tab to search; omit for the active tab"
        },
        "query": {
          "type": "string",
          "description": "Visible text to match, or /regex/ between slashes"
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "browser_act": {
      "type": "object",
      "properties": {
        "tabId": {
          "type": "string",
          "description": "Tab to act on; omit for the active tab"
        },
        "ref": {
          "type": "string",
          "description": "Element ref (@eN) from browser_snapshot or browser_find"
        },
        "verb": {
          "type": "string",
          "enum": [
            "click",
            "hover",
            "focus",
            "check",
            "uncheck"
          ],
          "description": "What to do to the element"
        },
        "includeSnapshot": {
          "type": "boolean",
          "default": false,
          "description": "Return a fresh snapshot with the result (token-expensive — request only when you need to see the outcome)"
        }
      },
      "required": [
        "ref",
        "verb"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "browser_type": {
      "type": "object",
      "properties": {
        "tabId": {
          "type": "string",
          "description": "Tab to act on; omit for the active tab"
        },
        "ref": {
          "type": "string",
          "description": "Element ref (@eN) of the input to type into"
        },
        "text": {
          "type": "string",
          "description": "Text to type"
        },
        "submit": {
          "type": "boolean",
          "default": false,
          "description": "Press Enter after typing"
        },
        "includeSnapshot": {
          "type": "boolean",
          "default": false,
          "description": "Return a fresh snapshot with the result (token-expensive)"
        }
      },
      "required": [
        "ref",
        "text"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "browser_fill_form": {
      "type": "object",
      "properties": {
        "tabId": {
          "type": "string",
          "description": "Tab to act on; omit for the active tab"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "description": "Element ref (@eN) of the field"
              },
              "value": {
                "type": "string",
                "description": "Value to fill in"
              }
            },
            "required": [
              "ref",
              "value"
            ],
            "additionalProperties": false
          },
          "description": "Fields to fill, in order"
        }
      },
      "required": [
        "fields"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "browser_press": {
      "type": "object",
      "properties": {
        "tabId": {
          "type": "string",
          "description": "Tab to act on; omit for the active tab"
        },
        "key": {
          "type": "string",
          "description": "Key or chord: \"Enter\", \"Tab\", \"Escape\", \"Control+a\""
        }
      },
      "required": [
        "key"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "browser_scroll": {
      "type": "object",
      "properties": {
        "tabId": {
          "type": "string",
          "description": "Tab to scroll; omit for the active tab"
        },
        "direction": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "top",
            "bottom"
          ],
          "description": "up/down = one viewport; top/bottom = jump to the edge"
        },
        "ref": {
          "type": "string",
          "description": "Scroll this container instead of the page"
        }
      },
      "required": [
        "direction"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "browser_wait": {
      "type": "object",
      "properties": {
        "tabId": {
          "type": "string",
          "description": "Tab to watch; omit for the active tab"
        },
        "forText": {
          "type": "string",
          "description": "Wait until this text appears on the page (substring)"
        },
        "forRef": {
          "type": "string",
          "description": "Wait until this element ref (@eN) is visible"
        },
        "forMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Wait a fixed number of milliseconds"
        },
        "timeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 15000,
          "description": "Give up after this long"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "browser_get": {
      "type": "object",
      "properties": {
        "tabId": {
          "type": "string",
          "description": "Tab to read; omit for the active tab"
        },
        "what": {
          "type": "string",
          "enum": [
            "text",
            "url",
            "title",
            "value"
          ],
          "description": "\"url\"/\"title\" are page-level; \"text\"/\"value\" read one element and need `ref`"
        },
        "ref": {
          "type": "string",
          "description": "Element ref (@eN) — required for \"text\" and \"value\""
        }
      },
      "required": [
        "what"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "browser_screenshot": {
      "type": "object",
      "properties": {
        "tabId": {
          "type": "string",
          "description": "Tab to capture; omit for the active tab"
        },
        "fullPage": {
          "type": "boolean",
          "default": false,
          "description": "Capture the whole page, not just the viewport"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "browser_tabs": {
      "type": "object",
      "properties": {},
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "browser_new_tab": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "URL to open the tab at; omit for the default start page"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "browser_close_tab": {
      "type": "object",
      "properties": {
        "tabId": {
          "type": "string",
          "description": "Tab to close; omit for the active tab — pass it explicitly when several are open"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "browser_mute": {
      "type": "object",
      "properties": {
        "tabId": {
          "type": "string",
          "description": "Tab to mute; omit for the active tab"
        },
        "muted": {
          "type": "boolean",
          "description": "true silences the tab, false restores audio"
        }
      },
      "required": [
        "muted"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "browser_show": {
      "type": "object",
      "properties": {
        "tabId": {
          "type": "string",
          "description": "Tab to present; omit for your session's active tab"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "worker": {
    "send_message_to_parent": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "The report text. First line MUST be `result: ...`, `needs input: ...`, or `failed: ...` (this line is parsed). See the send_message_to_parent guidance for the structure of the lines that follow."
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "current_datetime": {
      "type": "object",
      "properties": {},
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "browser_navigate": {
      "type": "object",
      "properties": {
        "tabId": {
          "type": "string",
          "description": "Tab to drive; omit for the active tab"
        },
        "action": {
          "type": "string",
          "enum": [
            "url",
            "back",
