      "blueprint": {
        "format": 1,
        "name": "Docs Review",
        "summary": "Reviews each pull request that changes the docs and drafts a review.",
        "icon": "eye",
        "aliases": [
          "docs"
        ],
        "kind": "standing",
        "takes": {
          "kind": "github.pull_request",
          "source": "github.pulls",
          "label": "pull request",
          "placeholder": "#470",
          "empty": "required",
          "many": true
        },
        "options": [],
        "when": {
          "on": [
            {
              "source": "github.pulls",
              "scope": {
                "repo": "acme/game"
              },
              "events": [
                "opened",
                "updated"
              ]
            },
            {
              "schedule": {
                "daily": "07:30",
                "days": "weekdays",
                "zone": "Europe/Istanbul"
              }
            }
          ],
          "limits": {
            "perHour": 30,
            "queued": 25
          }
        },
        "which": {
          "rule": {
            "all": [
              {
                "fact": "draft",
                "is": false
              },
              {
                "fact": "paths",
                "glob": "docs/**"
              }
            ]
          },
          "ask": "Does it change what a reader is told?"
        },
        "who": {
          "depth": "team",
          "agents": [
            {
              "key": "lead",
              "name": "Editor",
              "lead": true,
              "brief": "You are the editor.",
              "model": "sonnet",
              "effort": "medium",
              "tools": {
                "allow": [],
                "deny": []
              },
              "readsOutside": false,
              "workspace": "read"
            },
            {
              "key": "reader",
              "name": "Reader",
              "lead": false,
              "brief": "Read the pull request.",
              "model": "haiku",
              "effort": "low",
              "tools": {
                "allow": [],
                "deny": []
              },
              "readsOutside": true,
              "workspace": "read"
            }
          ],
          "checker": {
            "model": "sonnet",
            "effort": "high"
          }
        },
        "how": {
          "steps": [
            "Read the changed pages",
            "Check every link"
          ],
          "checks": [
            {
              "key": "cites",
              "text": "Every comment names a line."
            }
          ],
          "format": "review",
          "checkAgent": true
        },
        "makes": {
          "kind": "github.review",
          "description": "A pending review with line comments."
        },
        "goesTo": [
          {
            "id": "pr",
            "kind": "item_place",
            "channel": "github",
            "bound": {
              "fact": "repo",
              "in": [
                "acme/game"
              ]
            }
          }
        ],
        "freedom": {
          "rung": "draft",
          "grants": []
        },
        "limits": {
          "perRunUsd": 2,
          "perRunMinutes": 30,
          "perDayUsd": 5,
          "parallel": 1
        },
        "needs": [
          "github"
        ]
      }
    }
  ],
