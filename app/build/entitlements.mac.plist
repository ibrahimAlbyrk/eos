<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- V8 JIT under Hardened Runtime (plan §G). Deliberately NOT
       allow-unsigned-executable-memory — Electron >=12 on macOS doesn't need it
       and it widens the attack surface. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Eos hosts agents and terminals: commands they run ask macOS for these on
       Eos's behalf, and Hardened Runtime denies them without a prompt unless the
       app carries the entitlement (as Terminal-style apps do). -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.device.camera</key>
  <true/>
  <!-- Visual answers: the user's location, only while sharing is on (Settings ›
       General › Visual answers). Hardened Runtime denies CoreLocation without it. -->
  <key>com.apple.security.personal-information.location</key>
  <true/>
</dict>
</plist>
