<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- V8 JIT under Hardened Runtime (plan §G). Deliberately NOT
       allow-unsigned-executable-memory — Electron >=12 on macOS doesn't need it
       and it widens the attack surface. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
