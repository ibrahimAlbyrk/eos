    {
      "step": {
        "name": "scan-relative-path",
        "request": "POST /transfer/scan",
        "body": {
          "paths": [
            "beta"
          ]
        },
        "status": 400
      },
      "route": "POST /transfer/scan",
      "response": {
        "headers": {
          "content-type": "application/json"
