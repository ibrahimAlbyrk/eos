    {
      "step": {
        "name": "scan-folder-to-send",
        "request": "POST /transfer/scan",
        "body": {
          "paths": [
            "{sandbox}/beta/sub"
          ]
        },
        "status": 200,
        "capture": {
          "items": "/json/items"
