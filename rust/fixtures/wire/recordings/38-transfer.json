{
  "scenario": "38-transfer",
  "about": "The file-transfer endpoint every daemon serves over its own disk: list, scan, ranged read, staged write, commit, abort, project key.",
  "exchanges": [
    {
      "step": {
        "name": "list",
        "request": "GET /transfer/list",
        "query": {
          "path": "{sandbox}/beta"
        },
        "status": 200
      },
      "route": "GET /transfer/list",
      "response": {
        "headers": {
          "cache-control": "no-cache",
          "content-type": "application/json",
          "etag": "<etag>"
        },
        "json": {
          "entries": [
            {
              "isSymlink": false,
              "mtimeMs": "<now>",
              "name": "sub",
              "path": "{sandbox}/beta/sub",
              "size": null,
              "type": "directory"
            },
            {
              "isSymlink": false,
              "mtimeMs": "<now>",
              "name": "notes.md",
              "path": "{sandbox}/beta/notes.md",
              "size": 26,
              "type": "file"
            },
            {
              "isSymlink": false,
              "mtimeMs": "<now>",
              "name": "pixel.png",
              "path": "{sandbox}/beta/pixel.png",
              "size": 70,
              "type": "file"
            }
          ],
          "home": "{user_home}",
          "parent": "{sandbox}",
          "path": "{sandbox}/beta"
        },
        "status": 200
      }
    },
