        "json": {
          "error": "invalid request: paths.0: absolute path required"
        },
        "status": 400
      }
    },
    {
      "step": {
        "name": "read-range",
        "request": "GET /transfer/read",
        "query": {
          "length": "5",
          "mtime": "{mtime}",
          "offset": "2",
          "path": "{sandbox}/beta/notes.md",
          "size": "{size}"
        },
        "status": 200
      },
      "route": "GET /transfer/read",
      "response": {
        "bytes": 5,
        "headers": {
          "content-type": "application/octet-stream"
        },
        "sha256": "8a7525b1492fb84833f5c4a69b30f4bfbb134f9b666b61a2c1872d63d234c085",
        "status": 200
      }
    },
    {
      "step": {
        "name": "read-changed-file",
        "request": "GET /transfer/read",
        "query": {
          "length": "5",
          "mtime": "1",
          "offset": "0",
          "path": "{sandbox}/beta/notes.md",
          "size": "999"
        },
        "status": 412
      },
      "route": "GET /transfer/read",
      "response": {
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "code": "source-changed",
          "error": "notes.md changed while it was being copied — send it again"
        },
        "status": 412
      }
    },
    {
      "step": {
        "name": "prepare",
        "request": "POST /transfer/prepare",
        "body": {
          "destDir": "{sandbox}/incoming",
          "id": "tr-wire0001",
          "items": "{items}"
        },
        "status": 200
      },
      "route": "POST /transfer/prepare",
      "response": {
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "existing": [],
          "freeBytes": "<bytes>",
          "staged": {}
        },
        "status": 200
      }
    },
    {
      "step": {
        "name": "write-chunk",
        "request": "PUT /transfer/write",
        "query": {
          "dest": "{sandbox}/incoming",
          "id": "tr-wire0001",
          "offset": "0",
          "rel": "sub/inner.txt"
        },
        "text": "plain text\n",
        "content_type": "application/octet-stream",
        "status": 200
      },
      "route": "PUT /transfer/write",
      "response": {
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "size": 11
        },
        "status": 200
      }
    },
    {
      "step": {
        "name": "write-wrong-offset",
        "request": "PUT /transfer/write",
        "query": {
          "dest": "{sandbox}/incoming",
          "id": "tr-wire0001",
          "offset": "3",
          "rel": "sub/inner.txt"
        },
        "text": "x",
        "content_type": "application/octet-stream",
        "status": 409
      },
      "route": "PUT /transfer/write",
      "response": {
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "code": "offset-mismatch",
          "error": "sub/inner.txt holds 11 bytes, not 3",
          "have": 11
        },
        "status": 409
      }
    },
    {
      "step": {
        "name": "commit",
        "request": "POST /transfer/commit",
        "body": {
