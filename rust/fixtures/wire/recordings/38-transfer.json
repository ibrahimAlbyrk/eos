          ]
        },
        "status": 200,
        "capture": {
          "mtime": "/json/items/0/mtimeMs",
          "size": "/json/items/0/size"
        }
      },
      "route": "POST /transfer/scan",
      "response": {
        "headers": {
          "content-type": "application/json"
