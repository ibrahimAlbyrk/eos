{
  "scenario": "19-cors",
  "about": "Who may call the API listener from a browser: allowed and refused origins, preflight, the Host check against DNS rebinding, and the doors where neither applies.",
  "record_headers": [
    "access-control-allow-origin",
    "access-control-allow-methods",
    "access-control-allow-headers",
    "access-control-expose-headers",
    "access-control-max-age",
    "vary"
  ],
  "exchanges": [
    {
      "step": {
        "name": "no-origin",
        "request": "GET /health",
        "auth": "none",
        "status": 200
      },
      "route": "GET /health",
      "response": {
        "headers": {
          "access-control-allow-headers": "content-type, x-eos-ui-token, x-filename",
          "access-control-allow-methods": "GET, POST, PUT, DELETE, OPTIONS",
          "access-control-expose-headers": "content-disposition",
          "access-control-max-age": "86400",
          "content-type": "application/json",
          "vary": "Origin"
        },
        "json": {
          "fds": {
            "limit": "<count>",
            "open": "<count>"
          },
          "ok": true,
          "pid": "<pid>",
          "sourceStamp": "<source-stamp>",
          "startedAt": "<now>"
        },
        "status": 200
      }
    },
    {
      "step": {
        "name": "app-origin",
        "request": "GET /health",
        "headers": {
          "origin": "eos://app"
        },
        "auth": "none",
        "status": 200
      },
      "route": "GET /health",
      "response": {
        "headers": {
          "access-control-allow-headers": "content-type, x-eos-ui-token, x-filename",
          "access-control-allow-methods": "GET, POST, PUT, DELETE, OPTIONS",
          "access-control-allow-origin": "eos://app",
          "access-control-expose-headers": "content-disposition",
          "access-control-max-age": "86400",
          "content-type": "application/json",
          "vary": "Origin"
        },
        "json": {
          "fds": {
            "limit": "<count>",
            "open": "<count>"
          },
          "ok": true,
          "pid": "<pid>",
          "sourceStamp": "<source-stamp>",
          "startedAt": "<now>"
        },
        "status": 200
      }
    },
    {
      "step": {
        "name": "own-loopback-origin",
        "request": "GET /health",
        "headers": {
          "origin": "{api_origin}"
        },
        "auth": "none",
        "status": 200
      },
      "route": "GET /health",
      "response": {
        "headers": {
          "access-control-allow-headers": "content-type, x-eos-ui-token, x-filename",
          "access-control-allow-methods": "GET, POST, PUT, DELETE, OPTIONS",
          "access-control-allow-origin": "{api_origin}",
          "access-control-expose-headers": "content-disposition",
          "access-control-max-age": "86400",
          "content-type": "application/json",
          "vary": "Origin"
        },
        "json": {
          "fds": {
            "limit": "<count>",
            "open": "<count>"
          },
          "ok": true,
          "pid": "<pid>",
          "sourceStamp": "<source-stamp>",
          "startedAt": "<now>"
        },
        "status": 200
      }
    },
    {
      "step": {
        "name": "foreign-origin",
        "request": "GET /health",
        "headers": {
          "origin": "https://evil.example"
        },
        "auth": "none",
        "status": 403
      },
      "route": "GET /health",
      "response": {
        "headers": {
          "content-type": "application/json",
          "vary": "Origin"
        },
        "json": {
          "error": "origin not allowed"
        },
        "status": 403
      }
    },
    {
      "step": {
        "name": "null-origin",
        "request": "GET /health",
        "headers": {
          "origin": "null"
        },
        "auth": "none",
        "status": 403
      },
      "route": "GET /health",
      "response": {
        "headers": {
          "content-type": "application/json",
          "vary": "Origin"
        },
        "json": {
          "error": "origin not allowed"
        },
        "status": 403
      }
    },
    {
      "step": {
        "name": "raw-port-origin",
        "request": "GET /workers",
        "headers": {
          "origin": "{raw_origin}"
        },
        "status": 403
      },
      "route": "GET /workers",
      "response": {
        "headers": {
          "content-type": "application/json",
