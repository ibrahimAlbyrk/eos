        },
        "json": {
          "error": "origin not allowed"
        },
        "status": 403
      }
    },
    {
      "step": {
        "name": "foreign-origin-with-token",
        "request": "POST /terminal",
        "headers": {
          "origin": "https://evil.example"
        },
        "body": {
          "command": "echo never",
          "cwd": "{sandbox}/beta"
        },
        "status": 403
      },
      "route": "POST /terminal",
      "response": {
        "headers": {
          "content-type": "application/json",
          "vary": "Origin"
