    {
      "step": {
        "name": "preflight",
        "request": "OPTIONS /api/pages",
        "headers": {
          "access-control-request-headers": "content-type, x-eos-ui-token",
          "access-control-request-method": "POST",
          "origin": "eos://app"
        },
        "auth": "none",
        "status": 204
      },
      "response": {
        "headers": {
          "access-control-allow-headers": "content-type, x-eos-ui-token, x-filename",
          "access-control-allow-methods": "GET, POST, PUT, DELETE, OPTIONS",
          "access-control-allow-origin": "eos://app",
          "access-control-expose-headers": "content-disposition",
          "access-control-max-age": "86400",
          "vary": "Origin"
        },
        "status": 204
      }
    },
    {
      "step": {
        "name": "preflight-foreign",
        "request": "OPTIONS /api/pages",
        "headers": {
          "access-control-request-method": "POST",
          "origin": "https://evil.example"
        },
        "auth": "none",
        "status": 403
      },
      "response": {
        "headers": {
          "content-type": "application/json",
