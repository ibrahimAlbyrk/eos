    {
      "step": {
        "name": "foreign-origin-on-the-raw-port",
        "request": "GET /fs/raw{sandbox}/beta/notes.md",
        "headers": {
          "origin": "https://evil.example"
        },
        "auth": "none",
        "via": "raw",
        "status": 200
      },
      "route": "GET /fs/raw/* (raw)",
      "response": {
        "headers": {
          "accept-ranges": "bytes",
          "content-type": "text/plain; charset=utf-8"
        },
        "status": 200,
        "text": "# Notes\n\n- first\n- second\n"
      }
