          "access-control-allow-headers": "content-type, x-eos-ui-token, x-filename",
          "access-control-allow-methods": "GET, POST, PUT, DELETE, OPTIONS",
          "access-control-allow-origin": "eos://app",
          "access-control-expose-headers": "content-disposition",
          "access-control-max-age": "86400",
          "vary": "Origin"
        },
        "status": 204
      }
    },
    {
      "step": {
        "name": "options-without-origin",
        "request": "OPTIONS /health",
        "auth": "none",
        "status": 204
      },
      "response": {
        "headers": {
          "access-control-allow-headers": "content-type, x-eos-ui-token, x-filename",
          "access-control-allow-methods": "GET, POST, PUT, DELETE, OPTIONS",
          "access-control-expose-headers": "content-disposition",
          "access-control-max-age": "86400",
          "vary": "Origin"
        },
        "status": 204
      }
    },
