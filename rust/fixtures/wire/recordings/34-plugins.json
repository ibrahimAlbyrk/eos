      "route": "GET /stream",
      "response": {
        "frames": {
          "main": [
            {
              "retry": 2000
            },
            {
              "comment": "connected"
            },
            {
              "data": {
                "caps": [
                  "state:patch"
                ],
                "epoch": "<epoch>",
                "seq": "<seq>"
              },
              "event": "hello",
              "id": "<stream-id>"
            }
          ]
        },
        "headers": {
          "cache-control": "no-cache, no-transform",
          "content-type": "text/event-stream",
          "x-accel-buffering": "no"
        },
        "status": 200
      }
    },
