      },
      "route": "GET /stream",
      "response": {
        "frames": {
          "main": [
            {
              "retry": 2000
            },
            {
              "comment": "connected"
            },
            {
              "data": {
                "caps": [
                  "state:patch"
                ],
                "epoch": "<epoch>",
                "seq": "<seq>"
              },
              "event": "hello",
              "id": "<stream-id>"
