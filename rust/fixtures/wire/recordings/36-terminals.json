      "route": "GET /api/jobs/:id/output",
      "response": {
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "next": 13,
          "reset": false,
          "text": "wire\nproblem\n",
          "truncated": false
        },
        "status": 200
      }
    },
