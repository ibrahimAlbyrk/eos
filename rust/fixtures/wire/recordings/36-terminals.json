{
  "scenario": "36-terminals",
  "about": "Terminals: one-shot `!` commands with their output frames and the job they register; interactive PTY sessions (create, input, resize, buffer, close).",
  "exchanges": [
    {
      "step": {
        "name": "open-stream",
        "open": "main",
        "query": {
          "topics": "terminal:*,pty:session,pty:exit,jobs:*,worker:change"
        }
      },
      "route": "GET /stream",
      "response": {
        "frames": {
          "main": [
            {
              "retry": 2000
            },
            {
              "comment": "connected"
            },
            {
              "data": {
                "caps": [
                  "state:patch"
                ],
                "epoch": "<epoch>",
                "seq": "<seq>"
              },
              "event": "hello",
              "id": "<stream-id>"
            }
          ]
        },
        "headers": {
          "cache-control": "no-cache, no-transform",
          "content-type": "text/event-stream",
          "x-accel-buffering": "no"
        },
        "status": 200
      }
    },
    {
      "step": {
        "name": "run-without-token",
        "request": "POST /terminal",
        "auth": "none",
        "body": {
          "command": "echo hi",
          "cwd": "{sandbox}/beta"
        },
        "status": 403
      },
      "route": "POST /terminal",
      "response": {
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "error": "ui token required"
        },
        "status": 403
      }
    },
    {
      "step": {
        "name": "run-missing-folder",
        "request": "POST /terminal",
        "body": {
          "command": "echo hi",
          "cwd": "{sandbox}/nope"
        },
        "status": 400
      },
      "route": "POST /terminal",
      "response": {
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "error": "cwd does not exist"
        },
        "status": 400
      }
    },
    {
      "step": {
        "name": "run-invalid",
        "request": "POST /terminal",
        "body": {
          "cwd": "{sandbox}/beta"
        },
        "status": 400
      },
      "route": "POST /terminal",
      "response": {
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "error": "invalid request: command: Required"
        },
        "status": 400
      }
    },
    {
      "step": {
        "name": "run",
        "request": "POST /terminal",
        "body": {
          "command": "echo wire; echo problem >&2; exit 3",
          "cwd": "{sandbox}/beta"
        },
        "status": 200,
        "capture": {
          "run": "/json/runId"
        },
        "wait": [
          "terminal:start",
          "terminal:done"
        ]
      },
      "route": "POST /terminal",
      "response": {
        "frames": {
          "main": [
            {
              "data": {
                "payload": {
                  "command": "echo wire; echo problem >&2; exit 3",
                  "runId": "<uuid:1>",
                  "startedAt": "<now>",
                  "workerId": null
                },
                "reason": "terminal:start",
                "ts": "<now>"
              },
              "event": "change",
              "id": "<stream-id>"
            },
            {
              "data": {
                "payload": {
                  "command": "echo wire; echo problem >&2; exit 3",
                  "data": "wire\nproblem\n",
                  "runId": "<uuid:1>",
                  "workerId": null
                },
                "reason": "terminal:chunk",
                "ts": "<now>"
              },
              "event": "change",
              "id": "<stream-id>"
            },
            {
              "data": {
                "payload": {
                  "exitCode": 3,
                  "note": null,
                  "runId": "<uuid:1>",
                  "workerId": null
                },
                "reason": "terminal:done",
                "ts": "<now>"
              },
              "event": "change",
              "id": "<stream-id>"
            }
          ]
        },
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "runId": "<uuid:1>"
        },
        "status": 200
      }
    },
    {
      "step": {
        "name": "jobs-after-run",
        "request": "GET /api/jobs",
        "status": 200,
        "capture": {
          "job": "/json/jobs/0/id"
        }
      },
      "route": "GET /api/jobs",
      "response": {
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "jobs": [
            {
              "callId": null,
              "canStop": false,
              "command": "echo wire; echo problem >&2; exit 3",
              "detail": "exit 3",
              "endedAt": "<now>",
              "exitCode": 3,
              "hasOutput": true,
              "id": "shell:eos:run-<uuid:1>",
              "kind": "shell",
              "progress": null,
              "startedAt": "<now>",
              "status": "failed",
              "title": "echo wire; echo problem >&2; exit 3",
              "workerId": null
            }
          ]
        },
        "status": 200
      }
    },
    {
      "step": {
        "name": "jobs-without-token",
        "request": "GET /api/jobs",
        "auth": "none",
        "status": 403
      },
      "route": "GET /api/jobs",
      "response": {
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "error": "ui token required"
        },
        "status": 403
      }
    },
