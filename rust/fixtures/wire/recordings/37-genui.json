{
  "scenario": "37-genui",
  "about": "Visual answers: presenting a view and an app as an orchestrator or focused session, rejections with their problem list, reading a view, view state, and the media routes' refusals.",
  "exchanges": [
    {
      "step": {
        "name": "open-stream",
        "open": "main",
        "query": {
          "topics": "genui:*"
        }
      },
      "route": "GET /stream",
      "response": {
        "frames": {
          "main": [
            {
              "retry": 2000
            },
            {
              "comment": "connected"
            },
            {
              "data": {
                "caps": [
                  "state:patch"
                ],
                "epoch": "<epoch>",
                "seq": "<seq>"
              },
              "event": "hello",
              "id": "<stream-id>"
            }
          ]
        },
        "headers": {
          "cache-control": "no-cache, no-transform",
          "content-type": "text/event-stream",
          "x-accel-buffering": "no"
        },
        "status": 200
      }
    },
    {
      "step": {
        "name": "present",
        "request": "POST /api/genui/views",
        "headers": {
          "x-eos-agent-id": "w-CHAT"
        },
        "auth": "none",
        "body": {
          "input": {
            "actions": {
              "pick": {
                "kind": "send",
                "label": "Pick {{name}}"
              }
            },
            "data": {
              "places": [
                {
                  "area": "Old town",
                  "id": "a",
                  "name": "Bean",
                  "price": 2,
                  "rating": 4.5,
                  "type": "Place"
                },
                {
                  "area": "Harbour",
                  "id": "b",
                  "name": "Roast",
                  "price": 3,
                  "rating": 4.1,
                  "type": "Place"
                }
              ]
            },
            "icon": "coffee",
            "summary": "Bean (4.5) in the Old town and Roast (4.1) at the Harbour.",
            "title": "Two cafes",
            "tone": "teal",
            "ui": "<Section title=\"Cafes\"><List of=\"places\" variant=\"row\" meta=\"{{area}}\" actions=\"pick\"/></Section><Toggle bind=\"open\" label=\"Open now\"/>"
          }
        },
        "status": 201,
        "capture": {
          "view": "/json/viewId"
        }
      },
      "route": "POST /api/genui/views",
      "response": {
        "headers": {
          "content-type": "application/json"
