+/// The class name that makes a macOS window a non-activating panel (see `window_classname`).
+#[cfg(target_os = "macos")]
+pub const PANEL_CLASS: &str = "NSPanel";
+
 #[cfg(windows)]
 type PlatformAttributes = winit::platform::windows::WindowAttributesWindows;
