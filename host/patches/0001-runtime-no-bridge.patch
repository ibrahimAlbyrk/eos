"No bridge": a webview that carries nothing of Tauri into its pages.

Applies to: tauri-runtime-cef 3.0.0-alpha.7 (crates.io), applied in vendor/tauri-runtime-cef.
Offered upstream as `WebviewBuilderCefExt::no_bridge(true)`.

Why: every page in Eos is created without a bridge, the dashboard included. A stock Tauri
view exposes `window.ipc`, `__TAURI_INTERNALS__` and Tauri's init scripts to whatever page it
loads; Eos loads pages it does not control (the browser panel, claude.ai) and agent-written
HTML in sandboxed frames. With this option no initialization script is registered (Tauri's
own included), the drag-drop bridge script is not injected, a `tauri:ipc` message from the
view is dropped, and the browser is created with `extra_info {"tauri:no-bridge": true}` so
the renderer process does not install `window.ipc` (on macOS that half is patch 0002, in the
helper executable). The view is driven from Rust only: its `Webview` handle and the DevTools
protocol.

A popup opened by such a view gets the same `extra_info` entry: patch 0004.

diff --git a/src/cef_impl/ipc.rs b/src/cef_impl/ipc.rs
index 3a477a60..04b6a21b 100644
--- a/src/cef_impl/ipc.rs
+++ b/src/cef_impl/ipc.rs
@@ -106,16 +106,55 @@ fn install_ipc_post_message(context: Option<&mut V8Context>) {
   window.set_value_bykey(Some(&CefString::from("ipc")), Some(&mut ipc), attributes);
 }
 
+/// Key of the browser `extra_info` entry that marks a webview created with
+/// `CefWebviewAttributes::no_bridge`. The macOS helper executable
+/// (`tauri-bundler/cef-helper/main.rs`) reads the same key.
+pub(crate) const NO_BRIDGE_EXTRA_INFO_KEY: &str = "tauri:no-bridge";
+
+pub(crate) fn no_bridge_extra_info() -> Option<DictionaryValue> {
+  let info = dictionary_value_create()?;
+  info.set_bool(Some(&CefString::from(NO_BRIDGE_EXTRA_INFO_KEY)), 1);
+  Some(info)
+}
+
+/// Browsers of this renderer process that must not get `window.ipc`.
+static NO_BRIDGE_BROWSERS: Mutex<Vec<i32>> = Mutex::new(Vec::new());
+
 wrap_render_process_handler! {
   pub struct TauriRenderProcessHandler;
 
   impl RenderProcessHandler {
+    fn on_browser_created(
+      &self,
+      browser: Option<&mut Browser>,
+      extra_info: Option<&mut DictionaryValue>,
+    ) {
+      let (Some(browser), Some(extra_info)) = (browser, extra_info) else {
+        return;
+      };
+      if extra_info.bool(Some(&CefString::from(NO_BRIDGE_EXTRA_INFO_KEY))) == 1 {
+        NO_BRIDGE_BROWSERS.lock().unwrap().push(browser.identifier());
+      }
+    }
+
+    fn on_browser_destroyed(&self, browser: Option<&mut Browser>) {
+      if let Some(browser) = browser {
+        let id = browser.identifier();
+        NO_BRIDGE_BROWSERS.lock().unwrap().retain(|other| *other != id);
+      }
+    }
+
     fn on_context_created(
       &self,
-      _browser: Option<&mut Browser>,
+      browser: Option<&mut Browser>,
       _frame: Option<&mut Frame>,
       context: Option<&mut V8Context>,
     ) {
+      if let Some(browser) = browser
+        && NO_BRIDGE_BROWSERS.lock().unwrap().contains(&browser.identifier())
+      {
+        return;
+      }
       install_ipc_post_message(context);
     }
   }
