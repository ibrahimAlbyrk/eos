<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What tauri-cli adds by itself for a CEF app under the hardened runtime
     (Runtime::macos_entitlements): Chromium's JIT and the CEF framework need them.
     Apple Events: mail routines drive the Mail app; without it macOS refuses
     with -1743 and never asks the user. -->
<plist version="1.0"><dict>
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <key>com.apple.security.cs.disable-library-validation</key><true/>
  <key>com.apple.security.automation.apple-events</key><true/>
</dict></plist>
