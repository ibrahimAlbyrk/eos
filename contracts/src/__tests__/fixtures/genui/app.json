{
  "title": "V60 Brew Timer",
  "html": "<!doctype html>\n<html lang=\"tr\">\n<head>\n<meta charset=\"utf-8\">\n<style>\n  :root { color-scheme: dark; }\n  body { margin: 0; font-family: var(--font-sans, system-ui); background: #efe6d6; color: #2a2118; }\n  .wrap { display: grid; grid-template-columns: 240px 1fr; gap: 24px; padding: 24px; }\n  .dial { position: relative; width: 240px; height: 240px; }\n  .dial svg { width: 100%; height: 100%; transform: rotate(-90deg); }\n  .clock { position: absolute; inset: 0; display: grid; place-items: center; font: 600 40px/1 ui-monospace, monospace; }\n  button { font: inherit; border: 0; border-radius: 999px; padding: 8px 18px; background: #2a2118; color: #efe6d6; cursor: pointer; }\n  button.ghost { background: transparent; color: #2a2118; box-shadow: inset 0 0 0 1px #2a2118; }\n  li { list-style: none; padding: 6px 0; border-bottom: 1px dashed rgba(42,33,24,.25); }\n  li.done { opacity: .5; text-decoration: line-through; }\n  .now { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; opacity: .7; }\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <div>\n    <div class=\"dial\">\n      <svg viewBox=\"0 0 240 240\"><circle cx=\"120\" cy=\"120\" r=\"104\" fill=\"none\" stroke=\"rgba(42,33,24,.12)\" stroke-width=\"14\"/><circle id=\"arc\" cx=\"120\" cy=\"120\" r=\"104\" fill=\"none\" stroke=\"#b8562f\" stroke-width=\"14\" stroke-linecap=\"round\" stroke-dasharray=\"0 654\"/></svg>\n      <div class=\"clock\" id=\"clock\">0:00</div>\n    </div>\n    <p><button id=\"toggle\">Başlat</button> <button class=\"ghost\" id=\"reset\">Sıfırla</button></p>\n  </div>\n  <div>\n    <div class=\"now\">V60 · tek fincan · 15 g kahve · 250 g su · 94 °C</div>\n    <h2 id=\"stage\">Bloom</h2>\n    <p id=\"tip\">Kahveyi eşit ıslat, gazını salması için bekle.</p>\n    <ul id=\"stages\"></ul>\n  </div>\n</div>\n<script>\n  const stages = [\n    { name: \"Bloom\", a: 0, b: 45, target: \"40 g\", tip: \"Kahveyi eşit ıslat, gazını salması için bekle.\" },\n    { name: \"1. döküm\", a: 45, b: 90, target: \"150 g\", tip: \"Ortadan dışa yavaş spiraller, kenara değme.\" },\n    { name: \"2. döküm\", a: 90, b: 135, target: \"250 g\", tip: \"Aynı ritim; sonunda demliği hafifçe döndür.\" },\n    { name: \"Süzülme\", a: 135, b: 180, target: \"—\", tip: \"Son damlaya kadar bekle; 3:00 civarı bitmeli.\" }\n  ];\n  let t = 0, timer = null;\n  const fmt = (s) => Math.floor(s / 60) + \":\" + String(s % 60).padStart(2, \"0\");\n  function render() {\n    const cur = stages.find((s) => t < s.b) || stages[stages.length - 1];\n    document.getElementById(\"clock\").textContent = fmt(t);\n    document.getElementById(\"stage\").textContent = cur.name + \" · \" + cur.target;\n    document.getElementById(\"tip\").textContent = cur.tip;\n    document.getElementById(\"arc\").setAttribute(\"stroke-dasharray\", (t / 180) * 654 + \" 654\");\n    document.getElementById(\"stages\").innerHTML = stages\n      .map((s) => '<li class=\"' + (t >= s.b ? \"done\" : \"\") + '\">' + s.name + \" · \" + fmt(s.a) + \"–\" + fmt(s.b) + \" · \" + s.target + \"</li>\")\n      .join(\"\");\n    document.getElementById(\"toggle\").textContent = timer ? \"Duraklat\" : \"Başlat\";\n  }\n  document.getElementById(\"toggle\").onclick = () => {\n    if (timer) { clearInterval(timer); timer = null; }\n    else timer = setInterval(() => { t = Math.min(180, t + 1); if (t >= 180) { clearInterval(timer); timer = null; } render(); }, 1000);\n    render();\n  };\n  document.getElementById(\"reset\").onclick = () => { if (timer) clearInterval(timer); timer = null; t = 0; render(); };\n  render();\n  const ro = new ResizeObserver(() => parent.postMessage({ jsonrpc: \"2.0\", method: \"ui/notifications/size-changed\", params: { height: document.documentElement.scrollHeight } }, \"*\"));\n  ro.observe(document.body);\n</script>\n</body>\n</html>\n",
  "summary": "V60 için dört aşamalı demleme zamanlayıcısı: bloom (0:00–0:45, 40 g), 1. döküm (–1:30, 150 g), 2. döküm (–2:15, 250 g), süzülme (–3:00). 15 g kahve, 250 g su, 94 °C.",
  "height": 460
}
